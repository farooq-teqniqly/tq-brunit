<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA1303;CA1014</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Teqniqly.BRUnit.Testing\Teqniqly.BRUnit.Testing.csproj" />
  </ItemGroup>

  <Target Name="CopyBrunoCollection" AfterTargets="Build">
    <ItemGroup>
      <BrunoCollectionFiles Include="..\bruno-collection\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(BrunoCollectionFiles)"
      DestinationFiles="@(BrunoCollectionFiles->'$(OutputPath)bruno-collection\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
    />
  </Target>
</Project>
